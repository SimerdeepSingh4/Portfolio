# GitHub API Configuration
# GitHub Personal Access Token for API access
# Get it from: https://github.com/settings/tokens
# Required scopes: 'public_repo' for public repositories
VITE_GITHUB_TOKEN=your_github_token_here

# Note: 
# - Without a token, you're limited to 60 requests per hour (REST API only)
# - With a token, you get 5000 requests per hour + access to GraphQL API
# - Pinned repositories require GraphQL API (token required)
# - Accurate contribution counts require GraphQL API (token required)
# - If no token is provided, it will fall back to recent repositories and estimated contributions
